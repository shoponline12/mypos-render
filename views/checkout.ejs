<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Summer Shop Checkout</title>

<style>

body{
margin:0;
padding:40px;
font-family:Arial,sans-serif;
background:#f5f5f5;
}

.wrapper{
max-width:1200px;
margin:auto;
display:grid;
grid-template-columns:1fr 420px;
gap:30px;
}

.box{
background:#fff;
padding:30px;
border-radius:12px;
box-shadow:0 0 20px rgba(0,0,0,.08);
}

h2{
margin-top:0;
}

input{
width:100%;
padding:14px;
margin-bottom:15px;
border:1px solid #ddd;
border-radius:8px;
box-sizing:border-box;
}

button{
width:100%;
padding:16px;
background:#000;
color:#fff;
border:0;
border-radius:8px;
font-size:18px;
cursor:pointer;
}

button:hover{
opacity:.9;
}

.cart-item{
display:flex;
gap:15px;
margin-bottom:20px;
padding-bottom:20px;
border-bottom:1px solid #eee;
}

.cart-item img{
width:80px;
border-radius:8px;
}

</style>

</head>

<body>

<div class="wrapper">

<div class="box">

<h2>Η παραγγελία σας</h2>

<div id="cart-items">
Φόρτωση...
</div>

</div>

<div class="box">

<h2>Στοιχεία Πελάτη</h2>

<form action="/payment/create-payment" method="POST">

<input name="firstName" placeholder="Όνομα">

<input name="lastName" placeholder="Επώνυμο">

<input name="email" placeholder="Email">

<input name="phone" placeholder="Τηλέφωνο">

<input name="address" placeholder="Διεύθυνση">

<input name="city" placeholder="Πόλη">

<input name="zip" placeholder="Τ.Κ.">

<button type="submit">
Πληρωμή με myPOS
</button>

</form>

</div>

</div>

<script>

fetch("/cart")
.then(r=>r.json())
.then(cart=>{

let html="";

cart.items.forEach(item=>{

html+=`
<div class="cart-item">

<img src="${item.image}">

<div>

<b>${item.product_title}</b><br>

Ποσότητα: ${item.quantity}<br>

${(item.final_price/100).toFixed(2)} €

</div>

</div>
`;

});

html+=`<h3>Σύνολο ${(cart.total_price/100).toFixed(2)} €</h3>`;

document.getElementById("cart-items").innerHTML=html;

})
.catch(err=>{

document.getElementById("cart-items").innerHTML="Σφάλμα φόρτωσης καλαθιού";

console.log(err);

});

</script>

</body>
</html>

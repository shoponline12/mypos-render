# myPOS Checkout API configuration
# Use either a JSON string or key=value pairs separated by semicolons.

# Recommended sandbox endpoint configuration:
# MYPOS_CONFIG={"apiBase":"https://www.mypos.com/vmp/checkout-test","sid":"000000000000010","walletNumber":"61938166610","keyIndex":"1","urlOk":"https://your-app.com/payment/success","urlCancel":"https://your-app.com/payment/cancel","urlNotify":"https://your-app.com/payment/notify","ipcLanguage":"EN","ipcVersion":"1.4","outputFormat":"JSON"}

# Or the same values using key=value pairs:
# MYPOS_CONFIG=apiBase=https://www.mypos.com/vmp/checkout-test;sid=000000000000010;walletNumber=61938166610;keyIndex=1;urlOk=https://your-app.com/payment/success;urlCancel=https://your-app.com/payment/cancel;urlNotify=https://your-app.com/payment/notify;ipcLanguage=EN;ipcVersion=1.4;outputFormat=JSON

# RSA private key used to sign checkout requests. Keep this secret.
# MYPOS_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Optional public key for verifying myPOS callbacks and response signatures.
# MYPOS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Render will use environment variables configured in the dashboard.
# Do not store secrets in version control.

